# MySQL / MariaDB connection used by Prisma (CLI and runtime adapter)
DATABASE_URL="mysql://root@localhost:3306/course_platform"
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Public base URL of the app
APP_URL="http://localhost:3000"
# Optional SMTP for invites and password resets. Without it, emails are printed to the server console.
SMTP_URL=""
MAIL_FROM="Course Platform <no-reply@localhost>"
# Where uploaded files are stored locally
STORAGE_DIR="./storage"
