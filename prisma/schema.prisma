// Course Platform — data model.
// See docs/PLATFORM_SPEC.md §3. Models are added phase by phase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  SECRETARY
  TEACHER
  ASSISTANT
  STUDENT
  GUARDIAN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
}

// ─────────────── Identity (Better Auth core tables) ───────────────
// Field names on User/Session/Account/Verification must match Better Auth's schema.

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?    @db.Text
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles          UserRole[]
  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  guardianOf     GuardianLink[]  @relation("GuardianLinkGuardian")
  guardians      GuardianLink[]  @relation("GuardianLinkStudent")
  auditLogs      AuditLog[]

  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────── People ─────────────────────────

/// Global roles. A user can hold several (e.g. TEACHER + GUARDIAN).
model UserRole {
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model StudentProfile {
  userId                String        @id
  studentCode           String        @unique
  birthDate             DateTime?     @db.Date
  documentId            String?
  phone                 String?
  address               String?       @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Restricted: visible to SECRETARY and ADMIN only.
  medicalNotes          String?       @db.Text
  enrollmentDate        DateTime      @default(now()) @db.Date
  status                StudentStatus @default(ACTIVE)
  customFields          Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("student_profiles")
}

model TeacherProfile {
  userId      String    @id
  bio         String?   @db.Text
  specialties String?
  phone       String?
  hireDate    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model GuardianLink {
  guardianId   String
  studentId    String
  relationship String
  createdAt    DateTime @default(now())

  guardian User @relation("GuardianLinkGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([guardianId, studentId])
  @@index([studentId])
  @@map("guardian_links")
}

// ───────────────────────── Platform ─────────────────────────

/// Key/value settings. Each key holds one JSON group validated by a Zod schema
/// in src/features/settings/schemas.ts.
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
