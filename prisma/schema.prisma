// Course Platform — data model.
// See docs/PLATFORM_SPEC.md §3. Models are added phase by phase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  SECRETARY
  TEACHER
  ASSISTANT
  STUDENT
  GUARDIAN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
}

enum StudentDocumentType {
  ID_DOCUMENT
  TRANSCRIPT
  CONTRACT
  MEDICAL
  PHOTO
  OTHER
}

// ─────────────── Identity (Better Auth core tables) ───────────────
// Field names on User/Session/Account/Verification must match Better Auth's schema.

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?    @db.Text
  /// Contact phone (students, guardians, staff).
  phone         String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles          UserRole[]
  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  guardianOf     GuardianLink[]    @relation("GuardianLinkGuardian")
  guardians      GuardianLink[]    @relation("GuardianLinkStudent")
  auditLogs      AuditLog[]
  uploadedFiles  File[]
  documents      StudentDocument[] @relation("StudentDocuments")
  uploadedDocs   StudentDocument[] @relation("StudentDocumentUploader")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?  @db.Text
  /// Set when an admin is "viewing as" this user (custom impersonation plugin).
  impersonatedBy String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────── People ─────────────────────────

/// Global roles. A user can hold several (e.g. TEACHER + GUARDIAN).
model UserRole {
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model StudentProfile {
  userId                String        @id
  studentCode           String        @unique
  birthDate             DateTime?     @db.Date
  documentId            String?
  address               String?       @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Restricted: visible to SECRETARY and ADMIN only.
  medicalNotes          String?       @db.Text
  enrollmentDate        DateTime      @default(now()) @db.Date
  status                StudentStatus @default(ACTIVE)
  /// Internal notes for the office; never shown to the student.
  officeNotes           String?       @db.Text
  customFields          Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([documentId])
  @@map("student_profiles")
}

model TeacherProfile {
  userId      String    @id
  bio         String?   @db.Text
  specialties String?
  hireDate    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model GuardianLink {
  guardianId   String
  studentId    String
  relationship String
  createdAt    DateTime @default(now())

  guardian User @relation("GuardianLinkGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([guardianId, studentId])
  @@index([studentId])
  @@map("guardian_links")
}

/// Office documents attached to a student record. Visible to SECRETARY and ADMIN only.
model StudentDocument {
  id           String              @id @default(cuid())
  studentId    String
  fileId       String              @unique
  type         StudentDocumentType @default(OTHER)
  title        String
  notes        String?             @db.Text
  uploadedById String?
  createdAt    DateTime            @default(now())

  student    User  @relation("StudentDocuments", fields: [studentId], references: [id], onDelete: Cascade)
  file       File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("StudentDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("student_documents")
}

// ───────────────────────── Files ─────────────────────────

/// A stored blob. Access is decided by what references it (see src/features/files/access.ts).
model File {
  id           String   @id @default(cuid())
  storageKey   String   @unique @db.VarChar(512)
  originalName String
  mime         String
  size         Int
  ownerId      String?
  createdAt    DateTime @default(now())

  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  studentDocument StudentDocument?

  @@index([ownerId])
  @@map("files")
}

// ───────────────────────── Platform ─────────────────────────

/// Key/value settings. Each key holds one JSON group validated by a Zod schema
/// in src/features/settings/schemas.ts.
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

/// Named counters (e.g. "studentCode:2026"). Incrementing locks the row, so concurrent
/// transactions get distinct values.
model Sequence {
  name  String @id
  value Int

  @@map("sequences")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
