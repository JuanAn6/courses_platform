// Course Platform — data model.
// See docs/PLATFORM_SPEC.md §3. Models are added phase by phase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  SECRETARY
  TEACHER
  ASSISTANT
  STUDENT
  GUARDIAN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseVisibility {
  /// Listed in the public catalog (when published).
  CATALOG
  /// Only reachable by enrolled members and staff.
  PRIVATE
}

enum ClassStatus {
  /// Being prepared: visible to staff only.
  DRAFT
  ACTIVE
  /// Finished: read-only for students.
  COMPLETED
  ARCHIVED
}

enum ClassRole {
  TEACHER
  ASSISTANT
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

enum BoardPolicy {
  STUDENTS_CAN_POST
  COMMENT_ONLY
  READ_ONLY
}

/// Content types. Each has a Zod content schema, an editor and a viewer (src/features/entries/registry.ts).
enum EntryType {
  TEXT
  VIDEO
  AUDIO
  DOCUMENT
  PRESENTATION
  LINK
  EMBED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum FileStatus {
  READY
  PROCESSING
  FAILED
}

enum StudentDocumentType {
  ID_DOCUMENT
  TRANSCRIPT
  CONTRACT
  MEDICAL
  PHOTO
  OTHER
}

// ─────────────── Identity (Better Auth core tables) ───────────────
// Field names on User/Session/Account/Verification must match Better Auth's schema.

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?    @db.Text
  /// Contact phone (students, guardians, staff).
  phone         String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles          UserRole[]
  sessions       Session[]
  accounts       Account[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  guardianOf     GuardianLink[]    @relation("GuardianLinkGuardian")
  guardians      GuardianLink[]    @relation("GuardianLinkStudent")
  auditLogs      AuditLog[]
  uploadedFiles  File[]
  documents      StudentDocument[] @relation("StudentDocuments")
  uploadedDocs   StudentDocument[] @relation("StudentDocumentUploader")
  editedCourses  CourseEditor[]
  createdCourses Course[]          @relation("CourseCreator")
  memberships    ClassMember[]
  createdEntries Entry[]           @relation("EntryCreator")
  entryProgress  EntryProgress[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?  @db.Text
  /// Set when an admin is "viewing as" this user (custom impersonation plugin).
  impersonatedBy String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ───────────────────────── People ─────────────────────────

/// Global roles. A user can hold several (e.g. TEACHER + GUARDIAN).
model UserRole {
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model StudentProfile {
  userId                String        @id
  studentCode           String        @unique
  birthDate             DateTime?     @db.Date
  documentId            String?
  address               String?       @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Restricted: visible to SECRETARY and ADMIN only.
  medicalNotes          String?       @db.Text
  enrollmentDate        DateTime      @default(now()) @db.Date
  status                StudentStatus @default(ACTIVE)
  /// Internal notes for the office; never shown to the student.
  officeNotes           String?       @db.Text
  customFields          Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([documentId])
  @@map("student_profiles")
}

model TeacherProfile {
  userId      String    @id
  bio         String?   @db.Text
  specialties String?
  hireDate    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model GuardianLink {
  guardianId   String
  studentId    String
  relationship String
  createdAt    DateTime @default(now())

  guardian User @relation("GuardianLinkGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianLinkStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([guardianId, studentId])
  @@index([studentId])
  @@map("guardian_links")
}

/// Office documents attached to a student record. Visible to SECRETARY and ADMIN only.
model StudentDocument {
  id           String              @id @default(cuid())
  studentId    String
  fileId       String              @unique
  type         StudentDocumentType @default(OTHER)
  title        String
  notes        String?             @db.Text
  uploadedById String?
  createdAt    DateTime            @default(now())

  student    User  @relation("StudentDocuments", fields: [studentId], references: [id], onDelete: Cascade)
  file       File  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("StudentDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("student_documents")
}

// ───────────────────────── Academic structure ─────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  parentId    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@index([parentId])
  @@map("categories")
}

model AcademicTerm {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@index([startDate])
  @@map("academic_terms")
}

/// The catalog item and syllabus template. Content (units/entries) arrives in phase 4.
model Course {
  id          String           @id @default(cuid())
  code        String           @unique
  title       String
  slug        String           @unique
  /// One or two sentences for cards and the catalog.
  summary     String?          @db.VarChar(300)
  /// Plain text for now; rich text arrives with the content engine (phase 4).
  description String?          @db.Text
  level       String?
  categoryId  String?
  coverFileId String?          @unique
  status      CourseStatus     @default(DRAFT)
  visibility  CourseVisibility @default(CATALOG)
  /// Signed-in students may enroll themselves from the catalog.
  selfEnroll  Boolean          @default(false)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  category  Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverFile File?          @relation(fields: [coverFileId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  editors   CourseEditor[]
  classes   Class[]
  units     Unit[]

  @@index([status, visibility])
  @@index([categoryId])
  @@map("courses")
}

/// Teachers who may edit a course's content.
model CourseEditor {
  courseId  String
  userId    String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@index([userId])
  @@map("course_editors")
}

/// One delivery of a course to a group (own dates, staff and students).
model Class {
  id          String      @id @default(cuid())
  courseId    String
  termId      String?
  name        String
  code        String      @unique
  startDate   DateTime?   @db.Date
  endDate     DateTime?   @db.Date
  /// Max ACTIVE students; null = unlimited.
  capacity    Int?
  status      ClassStatus @default(DRAFT)
  boardPolicy BoardPolicy @default(STUDENTS_CAN_POST)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  course         Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  term           AcademicTerm?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  members        ClassMember[]
  units          Unit[]
  entryOverrides EntryClassOverride[]
  unitOverrides  UnitClassOverride[]
  progress       EntryProgress[]

  @@index([courseId])
  @@index([termId])
  @@index([status])
  @@map("classes")
}

/// Class staff and students. One row per person per class; history is kept via status/endedAt.
model ClassMember {
  id         String           @id @default(cuid())
  classId    String
  userId     String
  role       ClassRole
  status     MembershipStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  endedAt    DateTime?
  /// e.g. "Moved to MATH-101-B", "Withdrawn at parent's request".
  note       String?

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId, status])
  @@index([classId, role, status])
  @@map("class_members")
}

// ───────────────────────── Content ─────────────────────────

/// A section of a course (classId null) or class-only content (classId set).
model Unit {
  id                 String    @id @default(cuid())
  courseId           String
  classId            String?
  title              String
  description        String?   @db.Text
  position           Int       @default(0)
  releaseAt          DateTime?
  /// Unit whose required entries must be completed first.
  prerequisiteUnitId String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  course       Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  class        Class?              @relation(fields: [classId], references: [id], onDelete: Cascade)
  prerequisite Unit?               @relation("UnitPrerequisite", fields: [prerequisiteUnitId], references: [id], onDelete: SetNull)
  dependents   Unit[]              @relation("UnitPrerequisite")
  entries      Entry[]
  overrides    UnitClassOverride[]

  @@index([courseId, classId, position])
  @@map("units")
}

/// One content item. `content` and `settings` are validated per type by the entry registry.
model Entry {
  id          String        @id @default(cuid())
  unitId      String
  type        EntryType
  title       String
  description String?       @db.Text
  position    Int           @default(0)
  status      PublishStatus @default(DRAFT)
  required    Boolean       @default(true)
  releaseAt   DateTime?
  dueAt       DateTime?
  content     Json
  settings    Json?
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  unit      Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("EntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files     EntryFile[]
  overrides EntryClassOverride[]
  progress  EntryProgress[]

  @@index([unitId, position])
  @@map("entries")
}

/// Files referenced by an entry's content (for access checks and cleanup).
model EntryFile {
  entryId String
  fileId  String

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  file  File  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([entryId, fileId])
  @@index([fileId])
  @@map("entry_files")
}

/// Per-class changes to course content: hide it or shift its dates.
model EntryClassOverride {
  entryId   String
  classId   String
  hidden    Boolean   @default(false)
  releaseAt DateTime?
  dueAt     DateTime?
  updatedAt DateTime  @updatedAt

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([entryId, classId])
  @@index([classId])
  @@map("entry_class_overrides")
}

model UnitClassOverride {
  unitId    String
  classId   String
  hidden    Boolean   @default(false)
  releaseAt DateTime?
  updatedAt DateTime  @updatedAt

  unit  Unit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([unitId, classId])
  @@index([classId])
  @@map("unit_class_overrides")
}

model EntryProgress {
  id           String         @id @default(cuid())
  userId       String
  entryId      String
  classId      String
  status       ProgressStatus @default(IN_PROGRESS)
  /// 0–100
  percent      Int            @default(0)
  /// Seconds into a video/audio, or the page/slide number.
  lastPosition Float?
  timeSpentSec Int            @default(0)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  updatedAt    DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId, classId])
  @@index([classId, userId])
  @@index([entryId])
  @@map("entry_progress")
}

// ───────────────────────── Files ─────────────────────────

/// A stored blob. Access is decided by what references it (see src/features/files/access.ts).
model File {
  id           String     @id @default(cuid())
  storageKey   String     @unique @db.VarChar(512)
  originalName String
  mime         String
  size         Int
  ownerId      String?
  status       FileStatus @default(READY)
  /// Set on derived renditions (e.g. the PDF converted from a PowerPoint); access follows the source.
  sourceId     String?
  /// Derived renditions, e.g. { pdfFileId } for converted presentations, { error } on failure.
  derived      Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  studentDocument StudentDocument?
  courseCover     Course?
  entries         EntryFile[]
  source          File?            @relation("FileRenditions", fields: [sourceId], references: [id], onDelete: Cascade)
  renditions      File[]           @relation("FileRenditions")

  @@index([ownerId])
  @@index([sourceId])
  @@map("files")
}

// ───────────────────────── Platform ─────────────────────────

/// Key/value settings. Each key holds one JSON group validated by a Zod schema
/// in src/features/settings/schemas.ts.
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

/// Named counters (e.g. "studentCode:2026"). Incrementing locks the row, so concurrent
/// transactions get distinct values.
model Sequence {
  name  String @id
  value Int

  @@map("sequences")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
